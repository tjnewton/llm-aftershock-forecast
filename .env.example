# Copy to .env (git-ignored) and fill in. Never commit .env.
# Use the NEW key created for this project only.
ANTHROPIC_API_KEY=
# Hard spend cap in USD across all runs (the harness refuses batches that would exceed it).
LAF_SPEND_CAP_USD=150
# Local llama.cpp server (OpenAI-compatible endpoint), if used.
LAF_LOCAL_BASE_URL=http://127.0.0.1:9931/v1
ADAPTION_API_KEY=
